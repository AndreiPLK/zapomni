{
  "name": "Запомни",
  "short_name": "Запомни",
  "description": "Быстрые заметки голосом, фото и ссылками. Теги и поиск делает Claude.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#05070B",
  "theme_color": "#05070B",
  "lang": "ru",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Сказать", "short_name": "Сказать", "description": "Сразу записать голосом", "url": "./?go=voice", "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photo", "accept": ["image/*"] }]
    }
  }
}
